# CodeAtlas server
PORT=8000

# Required for public deployment
IMPORT_KEY=replace-with-a-long-random-management-key
SETTINGS_SECRET=replace-with-a-stable-encryption-secret
VERIFICATION_SECRET=replace-with-a-stable-verification-secret
# 受保护管理员邮箱：该邮箱注册后固定为 system_admin，且任何账号（含管理密钥）
# 都不能修改其角色、停用或删除。当前 SMTP 发信邮箱（MAIL_FROM_ADDRESS）会被自动
# 加入同一受保护名单，它注册后同样直接成为系统管理员 —— 两个账号互相也不可修改。
BOOTSTRAP_ADMIN_EMAIL=owner@example.com

# Optional data locations
# DATA_FILE=./server/data/knowledge.json
# USER_DATA_FILE=./server/data/users.json
# PLATFORM_DATA_FILE=./server/data/platform.json
# MAIL_SETTINGS_FILE=./server/data/mail-settings.json

# Optional SMTP defaults. These can also be edited at /manage/mail.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USERNAME=sender@example.com
# MAIL_PASSWORD=use-an-app-password
# MAIL_FROM_ADDRESS=sender@example.com
# MAIL_FROM_NAME=知图 CodeAtlas

# Optional frontend override, normally unnecessary in same-origin production.
# VITE_API_URL=/api/v1
